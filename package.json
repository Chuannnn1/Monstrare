    "kanban:migrate": "node scripts/migrate-kanban-data.mjs",
    "test": "npm run build && node --test \"tools/kanban/test/*.test.mjs\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.17.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
